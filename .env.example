# Verified live app. Update ONLY to a verified destination if the app moves.
NEXT_PUBLIC_APP_URL=https://samajaay.com/
# Public origin of the landing page, used for canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://samajaay.com/

# Owner-provided public GA4 stream. An explicit empty value disables measurement.
# No Google tag loads before the visitor accepts audience measurement.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2E8X0XGQX2

# Optional URL-prefix verification tokens: CONTENT value only, not the full meta tag.
# Prefer a Search Console Domain property verified by DNS for samajaay.com + www.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
